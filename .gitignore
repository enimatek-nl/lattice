# Build output
/bin/
/build/
/dist/
/server
/endpoints
/lattice
# a locally built binary used to replay a lab repro; /lattice above is the release
# name, and a name an operator would never ship under is exactly what gets built by
# hand next to the source
/lattice-new
/tmp-lattice-check/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage output. Deliberately not "coverage.*": that pattern also
# matches source files of a package named coverage, which silently keeps a
# package out of the repository.
*.test
*.out
coverage.out
coverage.html
*.cover
/profile/
*.pprof

# Runtime state: SQLite databases and media store
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
/media/
/tmp/
*.log

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
/secrets/

# Editors and OS cruft
/.idea/
/.vscode/
*.swp
*~
.DS_Store

# Assistant session state (pi): checkpoints of a conversation, not part of the
# server, and different on every machine that works on it
.pi/

# Generated OpenAPI docs (make swagger)
/docs/swagger/
# generated by `make endpoints` from internal/coverage/SPECS.md
ENDPOINTS.md

# Agent working notes: the trail, not the product (AGENTS.md §14).
.agent-work/

# Assistant session logs (pi): a transcript of one conversation, not part of the
# server, and different on every machine that works on it
/.pi-session/
